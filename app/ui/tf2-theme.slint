import "./assets/fonts/TF2Build.ttf";
import "./assets/fonts/BebasNeue-Regular.ttf";
import "./assets/fonts/Oswald-Variable.ttf";
import "./assets/fonts/RobotoCondensed-Variable.ttf";

export global Tf2Colors {
    in property <brush> app: #181918;
    in property <brush> header: #141514;
    in property <brush> panel: #24231f;
    in property <brush> panel-dark: #1d1d1b;
    in property <brush> table: #2b2b28;
    in property <brush> table-alt: #252522;
    in property <brush> border: #514b40;
    in property <brush> border-bright: #786d5b;
    in property <brush> cream: #decba9;
    in property <brush> muted: #a69882;
    in property <brush> dim: #756d60;
    in property <brush> neutral: #38342d;
    in property <brush> neutral-hover: #49443a;
    in property <brush> neutral-pressed: #2b2823;
    in property <brush> blu: #2a4558;
    in property <brush> blu-hover: #365a72;
    in property <brush> blu-pressed: #203542;
    in property <brush> red: #852c1b;
    in property <brush> red-hover: #a43a24;
    in property <brush> red-pressed: #672116;
    in property <brush> gold: #a26614;
    in property <brush> gold-hover: #bd7c1b;
    in property <brush> gold-pressed: #7b4d0d;
    in property <brush> green: #72b87a;
}

export component Tf2Panel inherits Rectangle {
    background: Tf2Colors.panel;
    border-width: 1px;
    border-color: Tf2Colors.border;
    clip: true;
}

export component Tf2Heading inherits Text {
    color: Tf2Colors.cream;
    font-family: "TF2 Build";
    font-size: 18px;
    vertical-alignment: center;
    wrap: word-wrap;
}

export component Tf2Label inherits Text {
    color: Tf2Colors.muted;
    font-family: "Oswald";
    font-weight: 500;
    font-size: 13px;
    vertical-alignment: center;
    wrap: word-wrap;
}

export component Tf2Body inherits Text {
    color: Tf2Colors.cream;
    font-family: "Roboto Condensed";
    font-size: 14px;
    vertical-alignment: center;
}

export component Tf2Button inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <brush> tone: Tf2Colors.neutral;
    in property <brush> hover-tone: Tf2Colors.neutral-hover;
    in property <brush> pressed-tone: Tf2Colors.neutral-pressed;
    in property <brush> text-color: Tf2Colors.cream;
    in property <length> label-font-size: 15px;
    callback clicked();

    height: 38px;
    min-width: 64px;
    opacity: root.enabled ? 1 : 0.42;
    background: !root.enabled ? Tf2Colors.neutral-pressed : area.pressed ? root.pressed-tone : area.has-hover ? root.hover-tone : root.tone;
    border-width: 1px;
    border-color: area.has-hover && root.enabled ? Tf2Colors.border-bright : Tf2Colors.border;
    clip: true;

    Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: 1px;
        background: area.pressed ? #2a272300 : #ffffff28;
    }
    Rectangle {
        x: 1px; y: parent.height - 2px; width: parent.width - 2px; height: 1px;
        background: #00000055;
    }
    Text {
        x: 6px;
        y: area.pressed && root.enabled ? 2px : 0px;
        width: parent.width - 12px;
        height: parent.height;
        text: root.text;
        color: root.text-color;
        font-family: "TF2 Build";
        font-size: root.label-font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    button-focus := FocusScope { enabled: root.enabled; }
    area := TouchArea {
        enabled: root.enabled;
        clicked => { button-focus.focus(); root.clicked(); }
    }
}

export component Tf2Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();

    height: 44px;
    min-width: 160px;
    background: !root.enabled ? Tf2Colors.panel-dark : area.pressed ? Tf2Colors.neutral-pressed : area.has-hover ? Tf2Colors.neutral-hover : Tf2Colors.neutral;
    border-width: 1px;
    border-color: root.active ? Tf2Colors.border-bright : Tf2Colors.border;
    opacity: root.enabled ? 1 : 0.45;
    clip: true;
    Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: 1px; background: #ffffff22; }
    Rectangle { x: 0px; y: parent.height - 4px; width: parent.width; height: 4px; background: root.active && root.enabled ? Tf2Colors.blu : #00000000; }
    Text {
        y: area.pressed ? 2px : 0px;
        width: parent.width;
        height: parent.height - 3px;
        text: root.text;
        color: !root.enabled ? Tf2Colors.dim : root.active ? #8ab3cd : Tf2Colors.cream;
        font-family: "TF2 Build";
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    tab-focus := FocusScope { enabled: root.enabled; }
    area := TouchArea { enabled: root.enabled; clicked => { tab-focus.focus(); root.clicked(); } }
}

export component Tf2LineEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <bool> centered: false;
    callback edited(string);
    callback focus-lost();

    height: 34px;
    background: input.has-focus ? #171816 : Tf2Colors.panel-dark;
    border-width: 1px;
    border-color: input.has-focus ? Tf2Colors.border-bright : Tf2Colors.border;
    opacity: root.enabled ? 1 : 0.5;
    clip: true;
    if root.text == "" && !input.has-focus : Text {
        x: 8px; width: parent.width - 16px; height: parent.height;
        text: root.placeholder;
        color: Tf2Colors.dim;
        font-family: "Roboto Condensed";
        font-size: 14px;
        horizontal-alignment: root.centered ? center : left;
        vertical-alignment: center;
        overflow: elide;
    }
    input-focus := FocusScope {
        x: 8px; y: 2px; width: parent.width - 16px; height: parent.height - 4px;
        focus-lost(reason) => { root.focus-lost(); }
        input := TextInput {
            width: parent.width; height: parent.height;
            text <=> root.text;
            color: Tf2Colors.cream;
            selection-background-color: Tf2Colors.blu;
            selection-foreground-color: Tf2Colors.cream;
            font-family: "Roboto Condensed";
            font-size: 14px;
            horizontal-alignment: root.centered ? center : left;
            vertical-alignment: center;
            single-line: true;
            enabled: root.enabled;
            edited => { root.edited(self.text); }
        }
    }
}

export component Tf2CheckBox inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> label-font-size: 12px;
    callback toggled(bool);

    height: 26px;
    background: #00000000;
    opacity: root.enabled ? 1 : 0.45;
    Rectangle {
        x: 0px; y: 4px; width: 18px; height: 18px;
        background: area.pressed ? Tf2Colors.neutral-pressed : area.has-hover ? Tf2Colors.neutral-hover : Tf2Colors.panel-dark;
        border-width: 1px;
        border-color: area.has-hover ? Tf2Colors.border-bright : Tf2Colors.border;
        Text {
            width: parent.width; height: parent.height;
            text: root.checked ? "X" : "";
            color: Tf2Colors.cream;
            font-family: "TF2 Build";
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: 27px; width: parent.width - 27px; height: parent.height;
        text: root.text;
        color: Tf2Colors.cream;
        font-family: "Roboto Condensed";
        font-size: root.label-font-size;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    area := TouchArea {
        enabled: root.enabled;
        clicked => { root.checked = !root.checked; root.toggled(root.checked); }
    }
}

export component Tf2Progress inherits Rectangle {
    in property <float> value;
    height: 12px;
    background: #121311;
    border-width: 1px;
    border-color: Tf2Colors.border;
    clip: true;
    Rectangle {
        x: 1px; y: 1px;
        width: Math.max(0px, (parent.width - 2px) * Math.min(1, Math.max(0, root.value)));
        height: parent.height - 2px;
        background: Tf2Colors.blu;
    }
}

// The same controls on every platform, independent of the OS light/dark theme.
export component Tf2ComboBox inherits Rectangle {
    in property <[string]> model;
    in-out property <string> current-value;
    in property <bool> enabled: true;
    private property <int> selected-index: 0;
    height: 30px; min-width: 55px;
    background: area.has-hover ? Tf2Colors.neutral : Tf2Colors.panel-dark;
    border-width: 1px; border-color: focus.has-focus ? Tf2Colors.blu-hover : Tf2Colors.border-bright;
    opacity: root.enabled ? 1 : 0.45;
    forward-focus: focus;
    accessible-role: combobox;
    accessible-value: root.current-value;
    for option[index] in root.model : Rectangle {
        visible: false;
        private property <bool> selected: root.current-value == option;
        init => { if self.selected { root.selected-index = index; } }
        changed selected => { if self.selected { root.selected-index = index; } }
    }
    Text { x: 9px; width: parent.width - 30px; height: parent.height; text: root.current-value; color: Tf2Colors.cream; font-family: "Roboto Condensed"; font-size: 13px; vertical-alignment: center; overflow: elide; }
    Text { x: parent.width - 24px; width: 20px; height: parent.height; text: "▼"; color: Tf2Colors.cream; font-size: 10px; vertical-alignment: center; horizontal-alignment: center; }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space { choices.show(); return accept; }
            if event.text == Key.DownArrow || event.text == Key.UpArrow {
                root.selected-index = Math.max(0, Math.min(root.model.length - 1, root.selected-index + (event.text == Key.DownArrow ? 1 : -1)));
                root.current-value = root.model[root.selected-index]; return accept;
            }
            return reject;
        }
    }
    area := TouchArea { enabled: root.enabled; clicked => { focus.focus(); choices.show(); } }
    choices := PopupWindow {
        x: 0px; y: root.height; width: Math.max(root.width, 220px); height: root.model.length * 27px + 8px;
        Rectangle {
            background: Tf2Colors.panel; border-width: 1px; border-color: Tf2Colors.border-bright;
            for option[index] in root.model : Rectangle {
                x: 4px; y: 4px + index * 27px; width: parent.width - 8px; height: 27px;
                background: root.current-value == option ? Tf2Colors.blu : row-area.has-hover ? Tf2Colors.neutral-hover : Tf2Colors.panel;
                Text { x: 8px; width: parent.width - 16px; height: parent.height; text: option; color: Tf2Colors.cream; font-family: "Roboto Condensed"; font-size: 13px; vertical-alignment: center; }
                row-area := TouchArea { clicked => { root.selected-index = index; root.current-value = option; choices.close(); } }
            }
        }
    }
}

export component Tf2SpinBox inherits Rectangle {
    in-out property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    callback edited(int);
    height: 30px; min-width: 65px;
    background: Tf2Colors.panel-dark; border-width: 1px; border-color: Tf2Colors.border-bright;
    forward-focus: input;
    input := TextInput {
        x: 8px; width: parent.width - 38px; height: parent.height;
        text: root.value; input-type: number;
        color: Tf2Colors.cream; font-family: "Roboto Condensed"; font-size: 13px; vertical-alignment: center;
        edited => { if self.text.is-float() { root.value = Math.max(root.minimum, Math.min(root.maximum, Math.round(self.text.to-float()))); root.edited(root.value); } }
        accepted => { self.text = root.value; }
        changed has-focus => { if !self.has-focus { self.text = root.value; } }
    }
    VerticalLayout { x: parent.width - 28px; width: 28px; spacing: 0px;
        Tf2Button { height: 15px; min-width: 20px; text: "+"; label-font-size: 10px; enabled: root.value < root.maximum; clicked => { root.value = Math.min(root.maximum, root.value + 1); root.edited(root.value); } }
        Tf2Button { height: 15px; min-width: 20px; text: "−"; label-font-size: 10px; enabled: root.value > root.minimum; clicked => { root.value = Math.max(root.minimum, root.value - 1); root.edited(root.value); } }
    }
}
