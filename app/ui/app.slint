import { ScrollView } from "std-widgets.slint";
import { Tf2Colors, Tf2Panel, Tf2Heading, Tf2Label, Tf2Body, Tf2Button, Tf2Tab, Tf2LineEdit, Tf2CheckBox, Tf2Progress, Tf2ComboBox, Tf2SpinBox } from "tf2-theme.slint";

// A complete tick (or whole-candidate) group. Keeping groups structured lets
// the table distinguish their origin without turning every individual tag into
// a separate visual chip.
export struct CandidateTagGroup {
    label: string, tags: string, width: int, highlighted: bool, has-separator: bool,
}

export struct CandidateRow {
    rank: int, score: string, kills: string, attacker: string, class-name: string, team: string,
    demo: string, map-name: string, mode: string, demo-type: string, recorded: string, ticks: string,
    tags: string, tag-width: int, tag-groups: [CandidateTagGroup], selected: bool,
}

export struct FilterOption {
    value: string,
    selected: bool,
}

component PagedText inherits Rectangle {
    min-width: 0px; min-height: 0px; preferred-width: 0px; preferred-height: 0px;
    in property <string> text;
    in-out property <bool> follow-latest: false;
    private property <int> page: 0;
    private property <length> stride: Math.max(24px, viewport.height - 24px);
    private property <int> pages: Math.max(1, Math.ceil((body.preferred-height - 24px) / root.stride));
    private property <int> current: root.follow-latest ? root.pages - 1 : Math.min(root.page, root.pages - 1);
    viewport := Rectangle {
        width: parent.width; height: parent.height - 32px; clip: true;
        body := Tf2Body { x: 4px; y: -root.current * root.stride; width: parent.width - 8px; height: self.preferred-height; text: root.text; wrap: word-wrap; font-size: 13px; vertical-alignment: top; }
    }
    if root.pages > 1 : HorizontalLayout {
        y: parent.height - 28px; height: 28px; spacing: 6px;
        Tf2Button { width: 88px; height: 28px; label-font-size: 12px; text: "Previous"; enabled: root.current > 0; clicked => { root.page = root.current - 1; root.follow-latest = false; } }
        Tf2Body { text: "Page " + (root.current + 1) + " / " + root.pages; horizontal-alignment: center; font-size: 12px; }
        Tf2Button { width: 72px; height: 28px; label-font-size: 12px; text: "Next"; enabled: root.current + 1 < root.pages; clicked => { root.page = root.current + 1; } }
        Tf2Button { width: 72px; height: 28px; label-font-size: 12px; text: "Latest"; clicked => { root.follow-latest = true; } }
    }
}

// Bounded lists use pages, so resizing never hides items behind a scrollbar.
component PagedDemoList inherits Rectangle {
    min-width: 0px; min-height: 0px; preferred-width: 0px; preferred-height: 0px;
    in property <[string]> items;
    in-out property <int> page: 0;
    private property <int> capacity: Math.max(1, Math.floor((self.height - 32px) / 25px));
    private property <int> pages: Math.max(1, Math.ceil(root.items.length / root.capacity));
    private property <int> current: Math.min(root.page, root.pages - 1);
    clip: true;
    for row in root.capacity : Tf2Body {
        x: 6px; y: row * 25px; width: parent.width - 12px; height: 25px;
        text: root.current * root.capacity + row < root.items.length ? root.items[root.current * root.capacity + row] : "";
        font-size: 13px; overflow: elide;
    }
    if root.pages > 1 : HorizontalLayout {
        y: parent.height - 28px; height: 28px; spacing: 6px;
        Tf2Button { width: 88px; height: 28px; label-font-size: 12px; text: "Previous"; enabled: root.current > 0; clicked => { root.page = root.current - 1; } }
        Tf2Body { text: "Page " + (root.current + 1) + " / " + root.pages; horizontal-alignment: center; font-size: 12px; }
        Tf2Button { width: 72px; height: 28px; label-font-size: 12px; text: "Next"; enabled: root.current + 1 < root.pages; clicked => { root.page = root.current + 1; } }
    }
}

component ParseOptionCard inherits Tf2Panel {
    in property <string> number;
    in property <string> heading;
    in property <string> description;
    in property <bool> dense;
    Rectangle { x: 10px; y: 10px; width: 40px; height: 40px; background: Tf2Colors.neutral; border-width: 1px; border-color: Tf2Colors.border-bright;
        Text { width: parent.width; height: parent.height; text: root.number; font-family: "TF2 Build"; font-size: 30px; color: Tf2Colors.cream; horizontal-alignment: center; vertical-alignment: center; }
    }
    Tf2Heading { x: 60px; y: 10px; width: parent.width * 0.40 - 70px; height: 22px; font-size: root.dense ? 14px : 18px; text: root.heading; }
    Tf2Body { x: 60px; y: 35px; width: parent.width * 0.40 - 70px; height: parent.height - 40px; text: root.description; wrap: word-wrap; vertical-alignment: top; color: Tf2Colors.muted; font-size: root.dense ? 12px : 14px; }
    Rectangle { x: parent.width * 0.40; y: 10px; width: parent.width * 0.60 - 12px; height: parent.height - 20px; @children }
}

component RecordingCard inherits Tf2Panel {
    in property <string> number;
    in property <string> heading;
    in property <string> description;
    Rectangle { x: 10px; y: 9px; width: 38px; height: 38px; background: Tf2Colors.neutral; border-width: 1px; border-color: Tf2Colors.border-bright;
        Text { width: parent.width; height: parent.height; text: root.number; font-family: "TF2 Build"; font-size: 28px; color: Tf2Colors.cream; horizontal-alignment: center; vertical-alignment: center; }
    }
    Tf2Heading { x: 58px; y: 8px; width: parent.width - 70px; height: 22px; font-size: 17px; text: root.heading; }
    Tf2Body { x: 58px; y: 31px; width: parent.width - 70px; height: 21px; text: root.description; font-size: 12px; color: Tf2Colors.muted; overflow: elide; }
    Rectangle { x: 12px; y: 59px; width: parent.width - 24px; height: parent.height - 69px; @children }
}

component SettingField inherits VerticalLayout {
    in property <string> label;
    spacing: 3px;
    Tf2Label { height: 17px; text: root.label; font-size: 13px; }
    Rectangle { height: 30px; @children }
}

component AppHeader inherits Rectangle {
    in property <int> page;
    in property <bool> compact;
    in property <bool> has-export;
    in property <string> frame-debug;
    in property <string> recording-save-status;
    in property <string> background-process-status;
    in property <bool> background-process-active;
    in-out property <bool> menu-open;
    callback navigate(int);

    height: root.compact ? 64px : 118px;
    background: Tf2Colors.header;
    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Tf2Colors.border; }

    if !root.compact : VerticalLayout {
        padding-left: 18px; padding-right: 18px; padding-top: 9px; padding-bottom: 0px;
        spacing: 6px;
        HorizontalLayout {
            height: 48px;
            Text { text: "Demo Toolkit"; color: Tf2Colors.cream; font-family: "TF2 Build"; font-size: 38px; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 5px;
            Tf2Tab { text: "PARSE DEMOS"; active: root.page == 0; clicked => { root.navigate(0); } }
            Tf2Tab { text: "CANDIDATES"; active: root.page == 1; enabled: root.has-export; clicked => { root.navigate(1); } }
            Tf2Tab { text: "RECORDING SETTINGS"; active: root.page == 2; enabled: root.has-export; min-width: 225px; clicked => { root.navigate(2); } }
            Tf2Tab { text: "APPLICATION LOGS"; active: root.page == 3; clicked => { root.navigate(3); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    if root.compact : HorizontalLayout {
        padding-left: 14px; padding-right: 12px; padding-top: 7px; padding-bottom: 7px;
        spacing: 12px;
        VerticalLayout {
            spacing: -2px;
            Text { text: "Demo Toolkit"; color: Tf2Colors.cream; font-family: "TF2 Build"; font-size: 28px; }
            Text {
                text: root.page == 0 ? "PARSE DEMOS" : root.page == 1 ? "CANDIDATES" : root.page == 2 ? "RECORDING SETTINGS" : root.page == 3 ? "APPLICATION LOGS" : "CANDIDATE DETAILS";
                color: #8ab3cd; font-family: "TF2 Build"; font-size: 12px;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        Tf2Button { width: 84px; height: 38px; text: root.menu-open ? "CLOSE" : "MENU"; clicked => { root.menu-open = !root.menu-open; } }
    }

    if root.background-process-status != "" : Text {
        x: root.compact ? 290px : parent.width - 656px;
        y: root.compact ? 7px : 9px;
        width: root.compact ? parent.width - 580px : 420px;
        height: root.compact ? 38px : 34px;
        text: root.background-process-active ? "BACKGROUND: " + root.background-process-status : "BACKGROUND: READY";
        color: root.background-process-active ? Tf2Colors.gold : #8ab3cd;
        font-family: "TF2 Build";
        font-size: root.compact ? 10px : 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    // Fixed diagnostic readout. It is deliberately outside the header layouts
    // so stretch calculations cannot hide or truncate it while resizing.
    Rectangle {
        x: root.compact ? parent.width - 272px : parent.width - 218px;
        y: root.compact ? 7px : 9px;
        width: root.compact ? 164px : 200px;
        height: root.compact ? 38px : 34px;
        background: Tf2Colors.neutral;
        border-width: 1px;
        border-color: Tf2Colors.border-bright;
        Text {
            x: 6px; width: parent.width - 12px; height: parent.height;
            text: root.frame-debug;
            color: #8ab3cd;
            font-family: "Roboto Condensed";
            font-size: root.compact ? 11px : 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component CandidateTableRow inherits Rectangle {
    in property <CandidateRow> entry;
    in property <int> index;
    in property <bool> compact;
    in property <bool> main-columns;
    in property <bool> extra-columns;
    in property <length> tag-column-width;
    callback drag(int, float, bool, bool);
    callback selection-done();

                height: 30px; clip: true;
                background: root.entry.selected ? Tf2Colors.gold : (Math.mod(root.index, 2) == 0 ? Tf2Colors.table : Tf2Colors.table-alt);
                row-focus := FocusScope { }
                HorizontalLayout {
                    x: 0px; width: root.width;
                    padding-left: 8px; padding-right: 8px; spacing: 8px;
                    if root.main-columns && root.compact : Tf2Body { text: root.entry.score; width: 75px; }
                    if root.main-columns && root.compact : Tf2Body { text: root.entry.recorded; width: 90px; color: root.entry.recorded == "Recorded" ? Tf2Colors.green : Tf2Colors.cream; horizontal-alignment: center; vertical-alignment: center; }
                    if root.main-columns && !root.compact : Tf2Body { text: root.entry.recorded; width: 90px; color: root.entry.recorded == "Recorded" ? Tf2Colors.green : Tf2Colors.cream; horizontal-alignment: center; vertical-alignment: center; }
                    if root.main-columns && !root.compact : Tf2Body { text: root.entry.score; width: 75px; }
                    if root.main-columns : Tf2Body { text: root.entry.map-name; width: 200px; overflow: elide; }
                    if root.main-columns : Tf2Body { text: root.entry.class-name; width: 110px; overflow: elide; }
                    if root.main-columns : Tf2Body { text: root.entry.ticks; width: 160px; overflow: elide; }
                    if root.extra-columns : Tf2Body { text: root.entry.mode; width: 220px; overflow: elide; }
                    if root.extra-columns && !root.compact : Tf2Body { text: root.entry.team; width: 90px; overflow: elide; }
                    if root.extra-columns : Rectangle {
                        width: root.tag-column-width; height: parent.height; clip: true;
                        HorizontalLayout {
                            padding-top: 4px; padding-bottom: 4px; spacing: 4px;
                            for group in root.entry.tag-groups : HorizontalLayout {
                                width: (group.width + (group.has-separator ? 18 : 0)) * 1px;
                                spacing: 4px;
                                Rectangle {
                                    width: group.width * 1px;
                                    background: group.highlighted ? #202a31 : #1b1c1b;
                                    border-width: 1px;
                                    border-color: group.highlighted ? #385061 : #343633;
                                    clip: true;
                                    HorizontalLayout {
                                        padding-left: 5px; padding-right: 5px; spacing: 3px;
                                        Text { text: group.label; color: #8ab3cd; font-family: "Roboto Condensed"; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                        Text { text: group.tags; color: Tf2Colors.cream; font-family: "Roboto Condensed"; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                                if group.has-separator : Rectangle {
                                    width: 14px; height: parent.height;
                                    background: #191a19;
                                    border-width: 1px; border-color: #3c4140;
                                    Text { width: parent.width; height: parent.height; text: "|"; color: Tf2Colors.muted; font-family: "Roboto Condensed"; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
                drag-area := TouchArea {
                    property <bool> drag-selecting; property <bool> dragging; property <bool> drag-additive;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            row-focus.focus();
                            self.drag-additive = event.modifiers.control;
                            self.drag-selecting = self.drag-additive ? !root.entry.selected : true;
                            self.dragging = true;
                            root.drag(root.index, 0, self.drag-selecting, self.drag-additive);
                        }
                        if (event.button == PointerEventButton.left && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel)) {
                            self.dragging = false; root.selection-done();
                        }
                    }
                    moved => { if (self.dragging) { root.drag(root.index, (self.mouse-y - self.pressed-y) / 1px, self.drag-selecting, self.drag-additive); } }
                }

}

component CandidateTable inherits Rectangle {
    min-width: 0px; min-height: 0px; preferred-width: 0px; preferred-height: 0px;
    in property <[CandidateRow]> rows;
    in property <bool> compact;
    in property <int> tags-width-px: 160;
    in-out property <length> horizontal-offset;
    callback drag(int, float, bool, bool);
    callback selection-done();

    background: Tf2Colors.panel-dark;
    border-width: 1px;
    border-color: Tf2Colors.border;
    clip: true;
    private property <length> content-width: root.width;
    private property <int> page: 0;
    private property <int> capacity: Math.max(1, Math.floor((root.height - 66px) / 30px));
    private property <int> pages: Math.max(1, Math.ceil(root.rows.length / root.capacity));
    private property <int> current: Math.min(root.page, root.pages - 1);
    private property <bool> more-columns: false;
    private property <bool> main-columns: root.width >= 1250px || !root.more-columns;
    private property <bool> extra-columns: root.width >= 1250px || root.more-columns;
    private property <length> tag-column-width: Math.max(80px, root.width - (root.width >= 1250px ? (root.compact ? 919px : 1017px) : (root.compact ? 252px : 350px)));

    Rectangle {
            x: 0px; y: 0px; width: root.width; height: 30px; background: Tf2Colors.neutral; clip: true;
            HorizontalLayout {
                x: 0px; width: root.content-width;
                padding-left: 8px; padding-right: 8px; spacing: 8px;
                if root.main-columns && root.compact : Text { text: "SCORE"; width: 75px; color: Tf2Colors.cream; font-family: "TF2 Build"; font-size: 12px; vertical-alignment: center; }
                if root.main-columns && root.compact : Text { text: "RECORDED"; width: 90px; color: Tf2Colors.cream; font-family: "TF2 Build"; font-size: 12px; vertical-alignment: center; horizontal-alignment: center; }
                if root.main-columns && !root.compact : Text { text: "RECORDED"; width: 90px; color: Tf2Colors.cream; font-family: "TF2 Build"; font-size: 12px; vertical-alignment: center; horizontal-alignment: center; }
                if root.main-columns && !root.compact : Text { text: "SCORE"; width: 75px; color: Tf2Colors.cream; font-family: "TF2 Build"; font-size: 12px; vertical-alignment: center; }
                if root.main-columns : Text { text: "MAP"; width: 200px; color: Tf2Colors.cream; font-family: "TF2 Build"; font-size: 12px; vertical-alignment: center; }
                if root.main-columns : Text { text: "CLASS"; width: 110px; color: Tf2Colors.cream; font-family: "TF2 Build"; font-size: 12px; vertical-alignment: center; }
                if root.main-columns : Text { text: "KILL TICK"; width: 160px; color: Tf2Colors.cream; font-family: "TF2 Build"; font-size: 12px; vertical-alignment: center; }
                if root.extra-columns : Text { text: "SERVER TYPE"; width: 220px; color: Tf2Colors.cream; font-family: "TF2 Build"; font-size: 12px; vertical-alignment: center; }
                if root.extra-columns && !root.compact : Text { text: "TEAM"; width: 90px; color: Tf2Colors.cream; font-family: "TF2 Build"; font-size: 12px; vertical-alignment: center; }
                if root.extra-columns : Text { text: "TAGS"; width: root.tag-column-width; color: Tf2Colors.cream; font-family: "TF2 Build"; font-size: 12px; vertical-alignment: center; }
            }
        }
        candidate-list := Rectangle {
            x: 0px; y: 30px; width: root.width; height: Math.max(0px, root.height - 64px);
            for slot in root.capacity : CandidateTableRow {
                y: slot * 30px; width: parent.width; height: 30px;
                index: root.current * root.capacity + slot;
                entry: root.rows[self.index]; visible: self.index < root.rows.length;
                compact: root.compact; main-columns: root.main-columns; extra-columns: root.extra-columns; tag-column-width: root.tag-column-width;
                drag(index, delta, selecting, additive) => { root.drag(index, delta, selecting, additive); }
                selection-done => { root.selection-done(); }
            }
        }
        Rectangle {
            x: 0px; y: root.height - 34px; width: root.width; height: 34px;
            HorizontalLayout { height: 34px; spacing: 6px;
            if root.width < 1250px : Tf2Button { width: 150px; height: 30px; label-font-size: 12px; text: root.more-columns ? "Main columns" : "Server / tags"; clicked => { root.more-columns = !root.more-columns; } }
            Rectangle { horizontal-stretch: 1; }
            Tf2Button { width: 88px; height: 30px; label-font-size: 12px; text: "Previous"; enabled: root.current > 0; clicked => { root.page = root.current - 1; } }
            Tf2Body { width: 110px; height: 30px; text: "Page " + (root.current + 1) + " / " + root.pages; horizontal-alignment: center; }
            Tf2Button { width: 72px; height: 30px; label-font-size: 12px; text: "Next"; enabled: root.current + 1 < root.pages; clicked => { root.page = root.current + 1; } }
        }
    }
}

component ClassFilter inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    width: 38px; height: 38px;
    background: selected ? Tf2Colors.gold : area.pressed ? Tf2Colors.neutral-pressed : area.has-hover ? Tf2Colors.neutral-hover : Tf2Colors.neutral;
    border-width: 1px; border-color: area.has-hover ? Tf2Colors.border-bright : Tf2Colors.border;
    if root.label == "" : Image { x: 4px; y: 4px; width: 30px; height: 30px; source: root.icon; image-fit: contain; }
    if root.label != "" : Text {
        width: parent.width; height: parent.height;
        text: root.label;
        color: Tf2Colors.cream;
        font-family: "TF2 Build";
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    class-focus := FocusScope { }
    area := TouchArea { clicked => { class-focus.focus(); root.clicked(); } }
}

component SecondsPicker inherits Rectangle {
    in-out property <int> seconds;
    private property <int> page: 0;
    height: 38px;
    background: area.pressed ? Tf2Colors.neutral-pressed : area.has-hover ? Tf2Colors.neutral-hover : Tf2Colors.panel-dark;
    border-width: 1px;
    border-color: area.has-hover ? Tf2Colors.border-bright : Tf2Colors.border;
    Text { x: 8px; width: parent.width - 24px; height: parent.height; text: root.seconds + "s"; color: Tf2Colors.cream; font-family: "Roboto Condensed"; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
    Text { x: parent.width - 20px; width: 16px; height: parent.height; text: "▼"; color: Tf2Colors.muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
    area := TouchArea { clicked => { seconds-popup.show(); } }
    seconds-popup := PopupWindow {
        x: 0px; y: root.height; width: Math.max(190px, root.width); height: 250px;
        Rectangle {
            background: Tf2Colors.panel;
            border-width: 1px; border-color: Tf2Colors.border-bright;
            Rectangle {
                x: 4px; y: 4px; width: parent.width - 8px; height: 196px;
                for slot in 7 : Rectangle {
                    private property <int> second: root.page * 7 + slot;
                    y: slot * 28px; width: parent.width; height: 28px; visible: second <= 60;
                    background: root.seconds == second ? Tf2Colors.gold : second-area.has-hover ? Tf2Colors.neutral-hover : Tf2Colors.panel-dark;
                    Text { width: parent.width; height: parent.height; text: second + "s"; color: Tf2Colors.cream; font-family: "Roboto Condensed"; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    second-area := TouchArea { clicked => { root.seconds = second; seconds-popup.close(); } }
                }
            }
            HorizontalLayout { x: 4px; y: 210px; width: parent.width - 8px; height: 28px; spacing: 4px;
                Tf2Button { width: 58px; height: 28px; text: "Prev"; label-font-size: 11px; enabled: root.page > 0; clicked => { root.page -= 1; } }
                Tf2Body { text: (root.page + 1) + "/9"; horizontal-alignment: center; }
                Tf2Button { width: 58px; height: 28px; text: "Next"; label-font-size: 11px; enabled: root.page < 8; clicked => { root.page += 1; } }
            }
        }
    }
}

component MultiSelectDropdown inherits Rectangle {
    in property <string> summary;
    in property <string> search-placeholder;
    in property <[FilterOption]> options;
    in property <int> content-width-px: 320;
    in-out property <string> search-text;
    callback search-edited(string);
    callback toggled(string);

    private property <int> page: 0;
    private property <int> pages: Math.max(1, Math.ceil(root.options.length / 5));
    private property <int> current: Math.min(root.page, root.pages - 1);
    height: 34px;
    background: area.pressed ? Tf2Colors.neutral-pressed : area.has-hover ? Tf2Colors.neutral-hover : Tf2Colors.panel-dark;
    border-width: 1px;
    border-color: area.has-hover ? Tf2Colors.border-bright : Tf2Colors.border;
    Text { x: 9px; width: parent.width - 34px; height: parent.height; text: root.summary; color: Tf2Colors.cream; font-family: "Roboto Condensed"; font-size: 13px; vertical-alignment: center; overflow: elide; }
    Text { x: parent.width - 26px; width: 18px; height: parent.height; text: "▼"; color: Tf2Colors.muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
    area := TouchArea { clicked => { filter-popup.show(); } }
    filter-popup := PopupWindow {
        x: 0px; y: root.height; width: Math.max(root.width, Math.max(320px, root.content-width-px * 1px)); height: 290px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Tf2Panel {
            VerticalLayout {
                padding: 8px; spacing: 6px;
                Tf2LineEdit { height: 32px; text <=> root.search-text; placeholder: root.search-placeholder; centered: true; edited(value) => { root.page = 0; root.search-edited(value); } }
                Rectangle { height: 140px;
                    for slot in 5 : Tf2CheckBox {
                        private property <int> index: root.current * 5 + slot;
                        y: slot * 28px; width: parent.width; height: 28px; visible: index < root.options.length;
                        text: root.options[index].value; checked: root.options[index].selected; toggled(checked) => { root.toggled(root.options[index].value); }
                    }
                }
                HorizontalLayout { height: 26px; spacing: 5px;
                    Tf2Button { width: 80px; height: 26px; text: "Previous"; label-font-size: 11px; enabled: root.current > 0; clicked => { root.page = root.current - 1; } }
                    Tf2Body { text: (root.current + 1) + " / " + root.pages; horizontal-alignment: center; }
                    Tf2Button { width: 64px; height: 26px; text: "Next"; label-font-size: 11px; enabled: root.current + 1 < root.pages; clicked => { root.page = root.current + 1; } }
                }
                Tf2Button { height: 30px; text: "CLOSE"; label-font-size: 12px; clicked => { filter-popup.close(); } }
            }
        }
    }
}

component ClassMultiSelectDropdown inherits Rectangle {
    in property <string> summary;
    in property <bool> scout;
    in property <bool> soldier;
    in property <bool> pyro;
    in property <bool> demoman;
    in property <bool> heavy;
    in property <bool> engineer;
    in property <bool> medic;
    in property <bool> sniper;
    in property <bool> spy;
    callback toggled(string);

    height: 34px;
    background: area.pressed ? Tf2Colors.neutral-pressed : area.has-hover ? Tf2Colors.neutral-hover : Tf2Colors.panel-dark;
    border-width: 1px;
    border-color: area.has-hover ? Tf2Colors.border-bright : Tf2Colors.border;
    Text { x: 9px; width: parent.width - 34px; height: parent.height; text: root.summary; color: Tf2Colors.cream; font-family: "Roboto Condensed"; font-size: 13px; vertical-alignment: center; overflow: elide; }
    Text { x: parent.width - 26px; width: 18px; height: parent.height; text: "▼"; color: Tf2Colors.muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
    area := TouchArea { clicked => { class-popup.show(); } }
    class-popup := PopupWindow {
        x: 0px; y: root.height; width: 238px; height: 200px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Tf2Panel {
            VerticalLayout {
                padding: 8px; spacing: 6px;
                Tf2Label { height: 18px; text: "SELECT CLASSES"; horizontal-alignment: center; }
                GridLayout {
                    spacing: 5px;
                    Row {
                        ClassFilter { icon: @image-url("assets/classes/all-classes.svg"); selected: !root.scout && !root.soldier && !root.pyro && !root.demoman && !root.heavy && !root.engineer && !root.medic && !root.sniper && !root.spy; clicked => { root.toggled("All"); } }
                        ClassFilter { icon: @image-url("assets/classes/scout.png"); selected: root.scout; clicked => { root.toggled("Scout"); } }
                        ClassFilter { icon: @image-url("assets/classes/soldier.png"); selected: root.soldier; clicked => { root.toggled("Soldier"); } }
                        ClassFilter { icon: @image-url("assets/classes/pyro.png"); selected: root.pyro; clicked => { root.toggled("Pyro"); } }
                        ClassFilter { icon: @image-url("assets/classes/demoman.png"); selected: root.demoman; clicked => { root.toggled("Demoman"); } }
                    }
                    Row {
                        ClassFilter { icon: @image-url("assets/classes/heavy.png"); selected: root.heavy; clicked => { root.toggled("Heavy"); } }
                        ClassFilter { icon: @image-url("assets/classes/engineer.png"); selected: root.engineer; clicked => { root.toggled("Engineer"); } }
                        ClassFilter { icon: @image-url("assets/classes/medic.png"); selected: root.medic; clicked => { root.toggled("Medic"); } }
                        ClassFilter { icon: @image-url("assets/classes/sniper.png"); selected: root.sniper; clicked => { root.toggled("Sniper"); } }
                        ClassFilter { icon: @image-url("assets/classes/spy.png"); selected: root.spy; clicked => { root.toggled("Spy"); } }
                    }
                }
                Tf2Button { height: 30px; text: "CLOSE"; label-font-size: 12px; clicked => { class-popup.close(); } }
            }
        }
    }
}

component MinimumScoreControl inherits Rectangle {
    in property <string> label;
    in-out property <int> value;
    callback edited(int);

    height: 34px;
    background: #00000000;
    border-width: 0px;
    HorizontalLayout {
        spacing: 5px;
        Text { width: root.label == "SCORE" ? 55px : 88px; text: root.label; color: Tf2Colors.muted; font-family: "Oswald"; font-weight: 500; font-size: 12px; vertical-alignment: center; }
        Tf2SpinBox { value <=> root.value; minimum: 0; maximum: 1000; edited(value) => { root.edited(value); } }
    }
}

component ShortcutCapture inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> binding;
    in property <length> label-width: 112px;
    private property <bool> capturing: false;
    private property <string> capture-message: "";
    height: 26px;
    spacing: 6px;
    Tf2Label { horizontal-stretch: 1; text: root.label; font-family: "Roboto Condensed"; font-size: 13px; overflow: elide; }
    key-button := Rectangle {
        width: 68px; height: 26px;
        background: key-touch.pressed ? Tf2Colors.border : key-touch.has-hover ? #333735 : Tf2Colors.neutral;
        border-width: 1px;
        border-color: root.capturing ? #8ab3cd : Tf2Colors.border-bright;
        Text {
            x: 4px; width: parent.width - 8px; height: parent.height;
            text: root.capturing ? (root.capture-message == "" ? "PRESS A KEY..." : root.capture-message) : root.binding;
            color: root.capturing ? #8ab3cd : Tf2Colors.cream;
            font-family: "TF2 Build";
            font-size: root.capturing ? 9px : 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        key-focus := FocusScope {
            width: parent.width; height: parent.height;
            focus-on-click: false;
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if (event.repeat) {
                    return accept;
                }
                if (event.text == Key.Escape) {
                    root.capturing = false;
                    root.capture-message = "";
                    key-focus.clear-focus();
                    return accept;
                }
                if (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                    root.capture-message = "ARROWS RESERVED";
                    return accept;
                }
                if (event.text == Key.Shift || event.text == Key.ShiftR || event.text == Key.Control || event.text == Key.ControlR || event.text == Key.Alt || event.text == Key.AltGr || event.text == Key.Meta || event.text == Key.MetaR || event.text == Key.CapsLock) {
                    root.capture-message = "PRESS ONE KEY";
                    return accept;
                }
                let captured = event.text == Key.Space ? "SPACE"
                    : event.text == Key.Tab || event.text == Key.Backtab ? "TAB"
                    : event.text == Key.Return ? "ENTER"
                    : event.text == Key.Backspace ? "BACKSPACE"
                    : event.text == Key.Delete ? "DEL"
                    : event.text == Key.Insert ? "INS"
                    : event.text == Key.Home ? "HOME"
                    : event.text == Key.End ? "END"
                    : event.text == Key.PageUp ? "PGUP"
                    : event.text == Key.PageDown ? "PGDN"
                    : event.text == Key.ScrollLock ? "SCROLLLOCK"
                    : event.text == Key.Pause ? "PAUSE"
                    : event.text == Key.F1 ? "F1" : event.text == Key.F2 ? "F2"
                    : event.text == Key.F3 ? "F3" : event.text == Key.F4 ? "F4"
                    : event.text == Key.F5 ? "F5" : event.text == Key.F6 ? "F6"
                    : event.text == Key.F7 ? "F7" : event.text == Key.F8 ? "F8"
                    : event.text == Key.F9 ? "F9" : event.text == Key.F10 ? "F10"
                    : event.text == Key.F11 ? "F11" : event.text == Key.F12 ? "F12"
                    : event.text;
                root.binding = captured;
                root.capturing = false;
                root.capture-message = "";
                key-focus.clear-focus();
                return accept;
            }
            focus-lost(reason) => {
                root.capturing = false;
                root.capture-message = "";
            }
        }
        key-touch := TouchArea {
            clicked => {
                root.capture-message = "";
                root.capturing = true;
                key-focus.focus();
            }
        }
    }
}

component MirvShortcutPanel inherits Rectangle {
    in property <bool> compact;
    in-out property <string> advance-time;
    in-out property <string> toggle-hud;
    in-out property <string> show-help;
    in-out property <string> back-one-second;
    in-out property <string> safe-restart;
    in-out property <string> next-kill-tick;
    in-out property <string> pause-resume;
    in-out property <string> enter-camera;
    in-out property <string> add-keyframe;
    in-out property <string> play-campath;
    in-out property <string> draw-campath;
    in-out property <string> start-recording;
    in-out property <string> stop-recording;
    in-out property <string> print-keyframes;
    in-out property <string> save-campath;
    in-out property <string> load-campath;
    in-out property <string> execute-director-action;
    in-out property <string> overlay-panel-toggle;
    in-out property <string> overlay-interaction-toggle;

    height: root.compact ? 300px : 250px;
    background: Tf2Colors.panel-dark;
    border-width: 1px;
    border-color: Tf2Colors.border;
    clip: true;
    VerticalLayout {
        padding: root.compact ? 7px : 10px; spacing: 5px;
        HorizontalLayout {
            height: 27px;
            Rectangle { width: 34px; height: 27px; background: Tf2Colors.neutral; border-width: 1px; border-color: Tf2Colors.border-bright; Tf2Heading { width: parent.width; height: parent.height; text: "5"; font-size: 22px; horizontal-alignment: center; } }
            Tf2Heading { text: "MIRV SHORTCUTS"; font-size: 17px; }
            Rectangle { horizontal-stretch: 1; }
            Tf2Button {
                width: root.compact ? 118px : 150px; height: 27px; label-font-size: 11px; text: "RESTORE DEFAULTS";
                clicked => {
                    root.advance-time = "["; root.toggle-hud = "]"; root.show-help = "1"; root.back-one-second = "2";
                    root.safe-restart = "3"; root.next-kill-tick = "4"; root.pause-resume = "5"; root.enter-camera = "6";
                    root.add-keyframe = "7"; root.play-campath = "8"; root.start-recording = "9"; root.stop-recording = "0";
                    root.draw-campath = "/"; root.print-keyframes = "-"; root.save-campath = "=";
                    root.load-campath = "F8";
                    root.execute-director-action = "'";
                    root.overlay-panel-toggle = "C";
                    root.overlay-interaction-toggle = "F11";
                }
            }
        }
        Tf2Body {
            height: 18px;
            text: "Click a bind, then press one keyboard key. Arrow keys are reserved for MIRV camera control.";
            color: Tf2Colors.muted;
            font-size: 11px;
            overflow: elide;
        }
        HorizontalLayout { height: 210px; spacing: 14px;
VerticalLayout { horizontal-stretch: 1; spacing: 2px; Tf2Heading { height: 20px; font-size: 12px; text: "Playback"; }
ShortcutCapture { label: "Advance 0.25s"; binding <=> root.advance-time; }
ShortcutCapture { label: "Toggle HUD"; binding <=> root.toggle-hud; }
ShortcutCapture { label: "Show controls"; binding <=> root.show-help; }
ShortcutCapture { label: "Back 1 second"; binding <=> root.back-one-second; }
ShortcutCapture { label: "Safe restart"; binding <=> root.safe-restart; }
ShortcutCapture { label: "Next frag (1s early)"; binding <=> root.next-kill-tick; }
ShortcutCapture { label: "Pause / resume"; binding <=> root.pause-resume; }Rectangle { vertical-stretch: 1; } }
VerticalLayout { horizontal-stretch: 1; spacing: 2px; Tf2Heading { height: 20px; font-size: 12px; text: "Camera & capture"; }
ShortcutCapture { label: "Enter MIRV camera"; binding <=> root.enter-camera; }
ShortcutCapture { label: "Add keyframe"; binding <=> root.add-keyframe; }
ShortcutCapture { label: "Play campath"; binding <=> root.play-campath; }
ShortcutCapture { label: "Draw campath"; binding <=> root.draw-campath; }
ShortcutCapture { label: "Start recording"; binding <=> root.start-recording; }
ShortcutCapture { label: "Stop recording"; binding <=> root.stop-recording; }Rectangle { vertical-stretch: 1; } }
VerticalLayout { horizontal-stretch: 1; spacing: 2px; Tf2Heading { height: 20px; font-size: 12px; text: "Campath & Director"; }
ShortcutCapture { label: "Print keyframes"; binding <=> root.print-keyframes; }
ShortcutCapture { label: "Save campath"; binding <=> root.save-campath; }
ShortcutCapture { label: "Load campath XML"; binding <=> root.load-campath; }
ShortcutCapture { label: "Emergency action"; binding <=> root.execute-director-action; }
ShortcutCapture { label: "Hide/show overlay"; binding <=> root.overlay-panel-toggle; }
ShortcutCapture { label: "Focus Director / TF2"; binding <=> root.overlay-interaction-toggle; }Rectangle { vertical-stretch: 1; } }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

export component AppWindow inherits Window {
